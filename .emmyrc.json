{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaLatest",
    "requireLikeFunction": [
      "UGCGameSystem.UGCRequire"
    ]
  },
  "diagnostics": {
    "disable": [
      "undefined-global",
      "unnecessary-if"
    ],
    "enable": false
  },
  "completion": {
    "autoRequire": false,
    "autoRequireFunction": "UGCGameSystem.UGCRequire",
    "callSnippet": false,
    "postfix": "@"
  },
  "doc": {
    "syntax": "md",
    "privateName": [
      "_*"
    ]
  }
}