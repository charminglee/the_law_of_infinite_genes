{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaLatest",
    "requireLikeFunction": [
      "UGCGameSystem.UGCRequire"
    ]
  },
  "diagnostics": {
    "disable": [
      "call-non-callable",
      "type-not-found",
      "iter-variable-reassign",
      "assign-type-mismatch",
      "need-check-nil",
      "access-invisible",
      "global-in-non-module",
      "undefined-field",
      "missing-parameter",
      "undefined-global",
      "unnecessary-if"
    ],
    "enable": true
  },
  "completion": {
    "autoRequire": false,
    "autoRequireFunction": "UGCGameSystem.UGCRequire",
    "callSnippet": false
  },
  "doc": {
    "syntax": "md",
    "privateName": [
      "_*"
    ]
  }
}